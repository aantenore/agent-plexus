    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "@agent-plexus/core": "^0.2.0"
  },
  "devDependencies": {
    "@agent-plexus/conformance": "0.2.0",
    "@agent-plexus/core": "0.2.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
