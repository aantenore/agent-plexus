{
  "name": "@agent-plexus/adapter-a2a-member",
  "version": "0.1.0",
  "description": "Calls a remote agent over the Agent2Agent (A2A) protocol as an agent-plexus member",
  "keywords": ["agent-plexus", "agent-plexus-adapter", "a2a"],
  "repository": { "type": "git", "url": "git+https://github.com/aantenore/agent-plexus.git", "directory": "adapters/a2a-member" },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "exports": {
    ".": {
      "@agent-plexus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@agent-plexus/source --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0"
  },
  "peerDependencies": {
    "@agent-plexus/core": "^0.1.0"
  },
  "devDependencies": {
    "@agent-layers/adapter-a2a": "0.2.0",
    "@agent-layers/adapter-basic-runtime": "0.2.0",
    "@agent-layers/adapter-mock-model": "0.2.0",
    "@agent-layers/adapter-static-identity": "0.2.0",
    "@agent-layers/core": "0.2.0",
    "@agent-layers/gateway": "0.2.0",
    "@agent-plexus/adapter-basic-topology": "0.1.0",
    "@agent-plexus/adapter-function-member": "0.1.0",
    "@agent-plexus/adapter-memory-execution": "0.1.0",
    "@agent-plexus/core": "0.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
