{
  "name": "@agent-plexus/cli",
  "version": "0.1.0",
  "description": "agent-plexus command line: check, run, resume, dev, eval",
  "keywords": ["agent-plexus", "agents", "multi-agent", "orchestration", "a2a", "ports-and-adapters", "cli"],
  "homepage": "https://github.com/aantenore/agent-plexus/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-plexus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-plexus.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "agent-plexus": "dist/cli.js"
  },
  "exports": {
    ".": {
      "@agent-plexus/source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@agent-plexus/source --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@agent-plexus/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
