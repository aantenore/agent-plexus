{
  "name": "@agent-plexus/adapter-memory-execution",
  "version": "0.1.0",
  "description": "In-memory execution journal for agent-plexus prototypes",
  "keywords": ["agent-plexus", "agents", "multi-agent", "orchestration", "a2a", "ports-and-adapters", "agent-plexus-adapter", "execution"],
  "homepage": "https://github.com/aantenore/agent-plexus/tree/main/adapters/memory-execution#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-plexus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-plexus.git",
    "directory": "adapters/memory-execution"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
