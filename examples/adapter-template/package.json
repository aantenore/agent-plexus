{
  "name": "@agent-plexus/example-adapter-template",
  "version": "0.2.1",
  "description": "Copyable skeleton of an agent-plexus adapter package",
  "keywords": ["agent-plexus", "agent-plexus-adapter"],
  "homepage": "https://github.com/aantenore/agent-plexus/tree/main/examples/adapter-template#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-plexus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-plexus.git",
    "directory": "examples/adapter-template"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@agent-plexus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "@agent-plexus/core": "^0.2.1"
  },
  "devDependencies": {
    "@agent-plexus/conformance": "0.2.1",
    "@agent-plexus/core": "0.2.1",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
