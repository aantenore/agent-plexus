{
  "name": "@agent-plexus/core",
  "version": "0.2.0",
  "description": "Ports, host hooks, the memberCall pipeline and system config for agent-plexus",
  "keywords": ["agent-plexus", "agents", "multi-agent", "orchestration", "a2a", "ports-and-adapters", "agent-orchestration", "core"],
  "homepage": "https://github.com/aantenore/agent-plexus/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-plexus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-plexus.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@agent-plexus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@agent-plexus/source --test \"test/**/*.test.ts\"",
    "prepack": "npm run build && node ../../scripts/copy-license.mjs && node ../../scripts/pack-manifest.mjs strip",
    "postpack": "node ../../scripts/pack-manifest.mjs restore"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
