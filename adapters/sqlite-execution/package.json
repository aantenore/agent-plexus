{
  "name": "@agent-plexus/adapter-sqlite-execution",
  "version": "0.2.0",
  "description": "Durable execution journal for agent-plexus on SQLite (node:sqlite)",
  "keywords": ["agent-plexus", "agents", "multi-agent", "orchestration", "a2a", "ports-and-adapters", "agent-plexus-adapter", "execution", "sqlite"],
  "homepage": "https://github.com/aantenore/agent-plexus/tree/main/adapters/sqlite-execution#readme",
  "bugs": {
    "url": "https://github.com/aantenore/agent-plexus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/agent-plexus.git",
    "directory": "adapters/sqlite-execution"
  },
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "@agent-plexus/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
