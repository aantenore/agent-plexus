    "prepack": "npm run build && node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "@agent-plexus/core": "^0.1.0"
  },
  "devDependencies": {
    "@agent-plexus/core": "0.1.0",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
